package httpserver_05;

import com.sun.net.httpserver.*;
import java.io.*;
import java.net.InetSocketAddress;

public class httpserver {
    public static void main(String[] args) throws IOException {

        // 1) 서버 생성 (포트 번호 채우기)
        HttpServer server = HttpServer.create(new InetSocketAddress(______), 0);

        // 2) 경로 "/" 요청 처리
        server.createContext("/", (exchange) -> {

            // 학생이 만들어야 할 메시지(HTML)
            String msg = "<h1>안녕하세요 👋 서버입니다!</h1>" +
                         "<p>제 이름은 <b>" + ________ + "</b> 입니다!</p>";

            exchange.getResponseHeaders().set("Content-Type", "text/html; charset=utf-8");
            
            // 응답 길이 계산 → 빈칸 채우기
            exchange.sendResponseHeaders(200, msg.getBytes().________);

            OutputStream os = exchange.getResponseBody();

            // 응답 전송 → 빈칸
            os.________(msg.getBytes());

            os.close();
        });

        // 3) 서버 시작
        server.start();
        System.out.println("🚀 서버 실행 중: http://localhost:______");
    }
}
