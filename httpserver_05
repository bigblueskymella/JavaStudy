package httpserver_05;

import com.sun.net.httpserver.*;
import java.io.*;
import java.net.InetSocketAddress;
import java.util.Date;

public class httpserver {
    public static void main(String[] args) throws IOException {

        // 서버 생성 (포트번호 8091~ + N)
        HttpServer server = HttpServer.create(new InetSocketAddress(809x), 0);

        // "/"로 요청이 들어왔을 때 실행할 코드
        server.createContext("/", (exchange) -> {
            String msg =
                    "<h1>안녕하세요 👋 한세고 서버입니다!</h1>" +
                    "<a href='about'>/about 가기</a><br>" +
                    "<a href='time'>/time 가기</a>";

            exchange.getResponseHeaders().set("Content-Type", "text/html; charset=utf-8");
            exchange.sendResponseHeaders(200, msg.getBytes().length);

            OutputStream os = exchange.getResponseBody();
            os.write(msg.getBytes());
            os.close();
        });

        // 서버 시작
        server.start();
        System.out.println("🚀 서버 실행 중: http://localhost:809x");
    }
}
